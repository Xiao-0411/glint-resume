# ====== LLM 配置 ======
LLM_BASE_URL=https://docs.newapi.pro/v1
LLM_API_KEY=
LLM_MODEL=claude-3-opus-20240229
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# true = 不调真实 LLM，走后端 mock 兜底
USE_MOCK=true

# ====== 应用配置 ======
# development = 本地开发，CORS 放行任意 localhost 端口(vite 跳到 5174 也能连)。
# 公网部署必须改成 production，否则线上会接受本机页面发来的带凭证请求。
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
CRAWLER_REQUEST_TIMEOUT_SECONDS=180
# 两轮抓取之间的间隔。单轮通常已耗时数分钟，此值只在单轮很快时生效；
# 无论如何都会至少静默 30 秒，避免连续请求触发平台风控。
CRAWLER_INTERVAL_SECONDS=60
# 每轮抓多少个关键词。城市走完一整圈后关键词自动前进，覆盖全部 30 个方向。
CRAWLER_MAX_KEYWORDS=5
DATABASE_URL=mysql+pymysql://root:你的phpstudy_mysql密码@localhost:3306/glint?charset=utf8mb4

# 用于签名登录 token 和验证码哈希。正式环境请换成长随机字符串。
AUTH_SECRET_KEY=change-me-to-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=10080

# ====== 超级管理员 ======
# 后端启动时会按这里创建/同步超级管理员账号。
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=超级管理员

# ====== LLM 用量记录与费控 ======
LLM_USAGE_ENABLED=true
LLM_DAILY_CALL_LIMIT_PER_USER=100
LLM_DAILY_TOKEN_LIMIT_PER_USER=200000
LLM_DAILY_COST_LIMIT_USD_PER_USER=5
LLM_INPUT_PRICE_PER_1M_USD=0
LLM_OUTPUT_PRICE_PER_1M_USD=0

# ====== 限流 ======
# 每个用户+IP 每分钟允许的 /api POST 请求数。
# 公网部署时设为 >0(如 60),防止 /api/chat 等被刷爆 LLM 费用。
RATE_LIMIT_PER_MIN=30

# ====== 日志与监控 ======
LOG_LEVEL=INFO
# Sentry DSN（可选，配置后自动启用错误追踪）
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ====== 邮箱验证码 ======
# 本地调试可以设为 true；正式使用必须为 false 并配置 SMTP。
EMAIL_VERIFICATION_DEV_MODE=true
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60

# SMTP 邮件服务配置
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=识光简历
SMTP_USE_SSL=true

# ====== 招聘平台爬虫 ======
# 全量抓取靠游标滚动完成：每轮只跑「城市切片 × 关键词切片」，位置记在
# crawl_cursor 表里，下一轮接着上次继续，最终覆盖 373 城市 × 30 关键词。
#
# CRAWLER_CITIES 留空 = 使用全部 373 个城市（热门城市优先）。
# 只想抓特定城市时才填写，用逗号分隔。
CRAWLER_CITIES=
# 每轮抓多少个城市。调大则单轮更久、全量周期更短。
CRAWLER_MAX_CITIES=4
CRAWLER_DETAIL_TIMEOUT_SECONDS=45
# BOSS_SCRAPER_CITY 仅作为直接调用 BOSS 适配器、且未传城市时的兼容兜底。
BOSS_SCRAPER_CITY=上海
BOSS_SCRAPER_PAGES=1
BOSS_SCRAPER_MAX_KEYWORDS=5
BOSS_SCRAPER_CDP_PORT=9222
BOSS_SCRAPER_TIMEOUT_SECONDS=90

# ====== 岗位 AI 分类 ======
# 独立于主站 LLM 配置，可指向另一个服务商/更便宜的模型。
# 协议为 Anthropic Messages 格式：POST {BASE_URL}/messages
# 三项都填上分类才会生效；留空则岗位照常入库，category 为空等待后续补分类。
JOB_CLASSIFIER_BASE_URL=
JOB_CLASSIFIER_API_KEY=
JOB_CLASSIFIER_MODEL=
JOB_CLASSIFIER_ANTHROPIC_VERSION=2023-06-01
# 单次请求携带的岗位数，过大易超时或被截断。
JOB_CLASSIFIER_BATCH_SIZE=20

# ====== 岗位详情（JD）后台补全 ======
# JD 只入库供匹配度计算，前端不展示。抓取慢且易触发风控，因此走独立低速通道。
JD_BACKFILL_ENABLED=true
# 每轮补多少条。调大会显著拉长单轮耗时。
JD_BACKFILL_BATCH=15
# 每条之间的随机间隔（秒），下限/上限。
JD_BACKFILL_MIN_DELAY=12
JD_BACKFILL_MAX_DELAY=25
# 连续失败多少条就中止本轮，避免风控期间持续送死。
JD_BACKFILL_FAIL_THRESHOLD=3
