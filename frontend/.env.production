# 前端生产环境变量（Cloudflare Pages 构建时使用）
VITE_USE_BACKEND=true
# 生产架构:sgjl.cloud 是 Cloudflare Pages 纯静态托管(没有 /api 反代,不能留空走同源),
# API 走 api.sgjl.cloud,由本机 Cloudflare Tunnel(.cloudflared/config-glint.yml)转发到 localhost:8000。
# 登录报 Network Error 时先查:1) cloudflared 是否在跑 2) 代理软件是否放行了 7844 端口。
VITE_API_BASE_URL=https://api.sgjl.cloud